# LEO Personal Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
LEO_TOKEN=change-me-to-something-secret

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-

# Gemini (optional, for TTS)
GEMINI_API_KEY=

# Obsidian Memory Vault
# Windows: C:\Users\fuadd\Desktop\Gehirn
# Unix: ~/.obsidian/leo-vault
LEO_VAULT_PATH=

# Memory settings
LEO_ENABLE_MEMORY=true
LEO_AUTO_INIT_VAULT=true
LEO_MAX_CONTEXT_CONVERSATIONS=5

# Voice settings (for later)
VOICE_PROVIDER=google
VOICE_LANGUAGE=de-DE

# Logging
DEBUG=leo:*
LOG_LEVEL=info
